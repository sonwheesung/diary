# 조각 서버 — 로컬 개발
#
# Supabase 로컬 스택을 띄우면(`npx supabase start`) 아래 값들이 콘솔에 출력된다.
# 그대로 .env.local 에 붙여넣는다. ⚠ .env.local 은 커밋하지 않는다.

# Supabase 로컬 스택의 Direct 연결(:54422). 마이그레이션도 이 문자열로 돈다.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54422/postgres"

# Storage API. `supabase start`가 출력하는 API URL 과 service_role key.
SUPABASE_URL="http://127.0.0.1:54421"
SUPABASE_SERVICE_ROLE_KEY=""

# 신원·권한을 물어볼 곳. 로컬에서 common_server를 함께 띄우면 3100이다.
COMMON_SERVER_URL="http://127.0.0.1:3100"
APP_CODE="jogak"

# 운영 콘솔. 16자 이상. 미설정이면 콘솔이 전면 차단된다(fail-closed)
ADMIN_TOKEN=

# AI 리포트 추론 강도. P1 실측(2026-08-13)으로 medium 확정 — low는 여러 날에 걸친 패턴을 놓친다
AI_EFFORT=medium
