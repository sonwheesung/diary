{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Node의 타입 스트리핑(`--experimental-strip-types`)이 지울 수 없는 문법을 막는다.
    // enum·namespace·parameter property가 여기 걸린다 — `features/backup/*`를 Node에서
    // 그대로 임포트해 KAT를 돌리므로, 하나만 들어와도 검증 스크립트가 통째로 죽는다.
    // 실제로 겪음(2026-08-11): `constructor(readonly code: string)` 하나로 전체가 멈췄다.
    "erasableSyntaxOnly": true,
    // features/backup/package.ts가 순수 계층을 상대경로+확장자로 임포트한다 —
    // Node가 스크립트로 그대로 읽어 전체 경로(봉인→개봉)를 검증하기 위해서다.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // server/ 는 별도 Next.js 앱이다 — 자기 tsconfig와 자기 `@/` 별칭을 갖는다.
  // 여기 포함하면 그쪽 `@/db`가 앱 루트로 해석돼 없는 모듈이 된다.
  // (Metro도 같은 이유로 metro.config.js의 blockList로 막아뒀다.)
  "exclude": ["node_modules", "**/*.test.ts", "server"]
}
