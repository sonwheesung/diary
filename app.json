{
  "expo": {
    "name": "조각",
    "slug": "jogak",
    "version": "0.2.4",
    "orientation": "portrait",
    "scheme": "jogak",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F7FA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.son0925.jogak"
    },
    "android": {
      "package": "com.son0925.jogak",
      "versionCode": 17,
      "backgroundColor": "#F5F7FA",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F5F7FA"
      },
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_APP_BADGE",
        "com.google.android.c2dm.permission.RECEIVE",
        "com.anddoes.launcher.permission.UPDATE_COUNT",
        "com.android.launcher.permission.INSTALL_SHORTCUT",
        "com.android.launcher.permission.UNINSTALL_SHORTCUT",
        "com.android.launcher.permission.READ_SETTINGS",
        "com.android.launcher.permission.WRITE_SETTINGS",
        "com.htc.launcher.permission.READ_SETTINGS",
        "com.htc.launcher.permission.UPDATE_SHORTCUT",
        "com.huawei.android.launcher.permission.CHANGE_BADGE",
        "com.huawei.android.launcher.permission.READ_SETTINGS",
        "com.huawei.android.launcher.permission.WRITE_SETTINGS",
        "com.majeur.launcher.permission.UPDATE_BADGE",
        "com.oppo.launcher.permission.READ_SETTINGS",
        "com.oppo.launcher.permission.WRITE_SETTINGS",
        "com.sec.android.provider.badge.permission.READ",
        "com.sec.android.provider.badge.permission.WRITE",
        "com.sonyericsson.home.permission.BROADCAST_BADGE",
        "com.sonymobile.home.permission.PROVIDER_INSERT_BADGE",
        "me.everything.badger.permission.BADGE_COUNT_READ",
        "me.everything.badger.permission.BADGE_COUNT_WRITE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-upload-signing",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FA",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#12161F"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "조각에 넣을 사진을 고르기 위해 사진 접근이 필요해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2731473780180274~6800808068",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-localization",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cb72932c-858b-4725-bde8-97bd9e36b718"
      }
    },
    "owner": "shs00925",
    "icon": "./assets/images/icon.png"
  }
}
