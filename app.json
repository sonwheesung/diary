{
  "expo": {
    "name": "조각",
    "slug": "jogak",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "jogak",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F7FA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.son0925.jogak"
    },
    "android": {
      "package": "com.son0925.jogak",
      "versionCode": 1,
      "backgroundColor": "#F5F7FA",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F5F7FA"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FA",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#12161F"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "조각에 넣을 사진을 고르기 위해 사진 접근이 필요해요.",
          "cameraPermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2731473780180274~6800808068",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-localization",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {}
    },
    "owner": "shs00925",
    "icon": "./assets/images/icon.png"
  }
}
