{
  "expo": {
    "name": "조각",
    "slug": "jogak",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "jogak",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F7FA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.son0925.jogak"
    },
    "android": {
      "package": "com.son0925.jogak",
      "versionCode": 1,
      "backgroundColor": "#F5F7FA",
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "조각에 넣을 사진을 고르기 위해 사진 접근이 필요해요.",
          "cameraPermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {}
    },
    "owner": "shs00925"
  }
}
