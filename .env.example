# 이 파일은 커밋된다. 실제 값은 `.env`에 두고, `.env`는 커밋하지 않는다(.gitignore).
#
# ⚠️ EXPO_PUBLIC_* 는 **빌드 시점에 번들로 인라인된다.**
#    ① 값을 바꾸면 dev 서버를 다시 띄워야 반영된다(리로드만으로는 안 된다).
#    ② 번들에 그대로 박히므로 **비밀을 넣지 않는다.** 여기에 들어갈 수 있는 것은
#       "공개돼도 되는 주소"까지다. LLM API 키 같은 것은 절대 넣지 않는다(CLAUDE.md §5.1).

# 공통 서버 — 공지 · 문의 · (예정) 로그인 · 엔타이틀먼트
# 비어 있으면 서버 연동 기능 전체가 조용히 비활성으로 동작한다. 일기 기능에는 지장이 없다.
EXPO_PUBLIC_SERVER_URL=https://common-server.vercel.app

# 구글 로그인 — 웹 클라이언트 ID (Google Cloud 프로젝트: google-oauth-test)
# ⚠ 안드로이드 네이티브 로그인이어도 idToken의 audience는 **웹 클라이언트 ID**다.
#    GoogleSignin에 이 값을 webClientId로 넘기고, common_server 관리자 콘솔의
#    audience에도 같은 값을 넣어야 한다. 빠뜨리면 전부 'unauthorized'로만 보인다.
# 비밀이 아니다 — 앱 번들에 어차피 박히는 공개 식별자다(시크릿은 서버만 갖는다).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=281316002652-v3959n7417plarerr1i1m7k9h71v5bgb.apps.googleusercontent.com
